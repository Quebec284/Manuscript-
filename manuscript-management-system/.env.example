# ───────────── Browser-side (public) values ─────────────
# Supabase → Project Settings → API. These are baked into the site at build time.
# The anon key is designed to be public; Row Level Security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
VITE_APP_NAME=Manuscript Management System
VITE_MAX_FILE_MB=10

# ───────────── Server-side secrets (NEVER prefix with VITE_, NEVER commit) ─────────────
# Used only by `npm run seed:admin` to create/update the administrator account.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=Change-Me-To-A-Strong-Password-1
